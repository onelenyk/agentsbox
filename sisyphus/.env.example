# Sisyphus environment — copy to `.env` and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Loaded at daemon/CLI startup (core/env.py). Precedence: a variable already set
# in the shell/launchd wins over .env.

# Optional: OpenRouter API key. Without it, opencode falls back to its own
# logged-in providers (the model prefix picks one, e.g. `deepseek/…`) and the
# claude-cli runner uses Claude Code's OAuth login.
OPENROUTER_API_KEY=

# Optional: shared bearer token protecting the JSON API when exposed on a
# network. Empty = disabled (loopback is allowed by default for local use).
SISYPHUS_API_TOKEN=

# Optional: webhook URL for outbound notifications (failed/parked tasks, a
# daemon that boots unable to run work). Empty = off.
SISYPHUS_NOTIFY_URL=

# Optional: forge integrations (publishing PRs/MRs, polling, webhooks).
# A per-repo `token:` in config.yaml beats these global ones.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITHUB_BASE_URL=
GITHUB_TOKEN=

# Optional: shared secret validating incoming webhook payloads (autopilots).
SISYPHUS_WEBHOOK_SECRET=

# Optional: override where the daemon keeps its data (db, repos, backups).
# Defaults to <repo>/workspace.
# WORKSPACE_ROOT=/absolute/path/to/workspace
